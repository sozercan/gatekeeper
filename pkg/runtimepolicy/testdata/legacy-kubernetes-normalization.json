[
  {
    "name": "explicit selectors and container types",
    "legacy": {
      "namespaceSelector": {
        "matchLabels": {
          "environment": "production"
        }
      },
      "podSelector": {
        "matchExpressions": [
          {
            "key": "app",
            "operator": "In",
            "values": [
              "agent",
              "worker"
            ]
          }
        ]
      },
      "containerTypes": [
        "Application",
        "Init"
      ],
      "excludedNamespaces": [
        "gatekeeper-system",
        "kube-*"
      ]
    },
    "normalized": {
      "kubernetes": {
        "namespaceSelector": {
          "matchLabels": {
            "environment": "production"
          }
        },
        "podSelector": {
          "matchExpressions": [
            {
              "key": "app",
              "operator": "In",
              "values": [
                "agent",
                "worker"
              ]
            }
          ]
        },
        "excludedNamespaces": [
          "gatekeeper-system",
          "kube-*"
        ],
        "containerTypes": [
          "Application",
          "Init"
        ]
      }
    }
  },
  {
    "name": "omitted container types retain legacy all-container semantics",
    "legacy": {
      "podSelector": {
        "matchLabels": {
          "runtime-policy": "restricted"
        }
      }
    },
    "normalized": {
      "kubernetes": {
        "podSelector": {
          "matchLabels": {
            "runtime-policy": "restricted"
          }
        },
        "containerTypes": [
          "Application",
          "Init",
          "Ephemeral"
        ]
      }
    }
  }
]
